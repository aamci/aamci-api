generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  password           String?           // Optionnel pour OAuth users
  role               Role
  fullName           String?
  avatarUrl          String?
  phone              String?
  sex                String?
  birthdate          DateTime?
  city               String?
  isActive              Boolean           @default(true)
  deletedAt             DateTime?         // Date de la demande de suppression
  scheduledDeletionAt   DateTime?         // Suppression définitive prévue (deletedAt + 30j)
  emailVerified      Boolean           @default(false)
  verificationToken     String?           @unique
  tokenExpiry           DateTime?
  resetPasswordToken    String?           @unique
  resetPasswordExpiry   DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  doctorProfile      DoctorProfile?
  patientProfile     PatientProfile?
  facilityManager    FacilityManager?
  appointments       Appointment[]     @relation("PatientAppointments")
  appointmentKinds   AppointmentKind[]
  appointmentHistory AppointmentHistory[] @relation("AppointmentHistoryUser")
  notifications      Notification[]
  accounts           Account[]         // OAuth accounts

  // Medical Notes relations
  patientNotes       MedicalNote[]     @relation("PatientNotes")
  doctorNotes        MedicalNote[]     @relation("DoctorNotes")

  // Favorite Doctors relations
  favoriteDoctors    FavoriteDoctor[]  @relation("PatientFavorites")
  favoritedBy        FavoriteDoctor[]  @relation("DoctorFavorites")

  // Medical Documents relations
  medicalDocuments   MedicalDocument[] @relation("PatientDocuments")

  // Transactions relations (nommées pour éviter ambiguïté)
  doctorTransactions  Transaction[]     @relation("DoctorTransactions")
  patientTransactions Transaction[]     @relation("PatientTransactions")
  wallet              Wallet?

  // Invoices relations
  doctorInvoices      Invoice[]         @relation("DoctorInvoices")
  patientInvoices     Invoice[]         @relation("PatientInvoices")

  // Prescriptions relations
  doctorPrescriptions  Prescription[]    @relation("DoctorPrescriptions")
  patientPrescriptions Prescription[]    @relation("PatientPrescriptions")

  // Tasks relations
  doctorTasks         Task[]            @relation("DoctorTasks")
  patientTasks        Task[]            @relation("PatientTasks")

  // Dossier patient relations
  patientMedicalHistory   MedicalHistory[]       @relation("PatientMedicalHistory")
  doctorMedicalHistory    MedicalHistory[]       @relation("DoctorMedicalHistory")
  patientVaccinations     Vaccination[]          @relation("PatientVaccinations")
  patientTreatments       Treatment[]            @relation("PatientTreatments")
  doctorTreatments        Treatment[]            @relation("DoctorTreatments")
  patientBiometrics       BiometricMeasurement[] @relation("PatientBiometrics")
  doctorBiometrics        BiometricMeasurement[] @relation("DoctorBiometrics")
  patientObservations     ClinicalObservation[]  @relation("PatientObservations")
  doctorObservations      ClinicalObservation[]  @relation("DoctorObservations")
  patientLabResults       LabResult[]            @relation("PatientLabResults")
  doctorLabResults        LabResult[]            @relation("DoctorLabResults")
  emergencyContacts       EmergencyContact[]     @relation("PatientEmergencyContacts")
  patientConsents         PatientConsent[]       @relation("PatientConsents")

  // Reviews & Ratings
  patientReviews          DoctorReview[]         @relation("PatientReviews")

  // Health Record
  healthRecord            HealthRecord?          @relation("PatientHealthRecord")

  // Two-Factor Auth
  twoFactorAuth           TwoFactorAuth?

  // Webhooks
  webhookSubscriptions    WebhookSubscription[]

  // Consultations relations
  patientConsultations    Consultation[]         @relation("PatientConsultations")
  doctorConsultations     Consultation[]         @relation("DoctorConsultations")

  // Messages relations
  conversationsAsP1       Conversation[]         @relation("ConversationParticipant1")
  conversationsAsP2       Conversation[]         @relation("ConversationParticipant2")
  sentMessages            Message[]              @relation("MessageSender")

  // Admin audit
  adminAuditLogs          AdminAuditLog[]        @relation("AdminAuditLogs")

  // Contracts & Tickets
  contracts               Contract[]             @relation("UserContracts")
  supportTickets          SupportTicket[]        @relation("TicketAuthor")

  // Referrals
  referralsSent           Referral[]             @relation("ReferralFrom")
  referralsReceived       Referral[]             @relation("ReferralTo")
  referralsAsPatient      Referral[]             @relation("ReferralPatient")

  // Medical Correspondences (courrier médical entre confrères)
  correspondencesSent      MedicalCorrespondence[] @relation("CorrespondenceSender")
  correspondencesReceived  MedicalCorrespondence[] @relation("CorrespondenceRecipient")
  correspondencesAsPatient MedicalCorrespondence[] @relation("CorrespondencePatient")

  // Liste d'attente
  waitlistAsPatient        WaitlistEntry[]         @relation("WaitlistPatient")
  waitlistAsDoctor         WaitlistEntry[]         @relation("WaitlistDoctor")

  // Questionnaires créés par le médecin
  questionnaires           Questionnaire[]         @relation("DoctorQuestionnaires")

  // Proches (beneficiaries)
  beneficiaries            Beneficiary[]           @relation("PatientBeneficiaries")

  // Reports & Blocks
  reportsMade              Report[]                @relation("ReportsMade")
  reportsReceived          Report[]                @relation("ReportsReceived")
  blocksMade               Block[]                 @relation("BlocksMade")
  blocksReceived           Block[]                 @relation("BlocksReceived")

  // Auth logs
  authLogs                 AuthLog[]               @relation("UserAuthLogs")
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  HOSPITAL
  ADMIN
  FACILITY_MANAGER
  ADMIN_READ
  ADMIN_WRITE
  GUEST
  SECRETARY
}

model Appointment {
  id         String            @id @default(cuid())
  slotId     String
  patientId  String
  status     AppointmentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime          @default(now())
  type       String?
  kindId     String?
  kind       AppointmentKind?  @relation(fields: [kindId], references: [id])

  // Bénéficiaire (réservation pour quelqu'un d'autre)
  beneficiaryName  String?
  beneficiaryPhone String?

  // Téléconsultation
  videoSessionId   String?   @unique  // ID unique pour la session vidéo
  videoRoomUrl     String?   // URL de la salle de visio (pour intégration externe)
  videoStartedAt   DateTime? // Début de la session vidéo
  videoEndedAt     DateTime? // Fin de la session vidéo

  // Établissement choisi lors de la prise de RDV
  facilityId    String?
  facility      Facility?           @relation(fields: [facilityId], references: [id])

  // Check-in patient
  checkedInAt   DateTime?

  // RDV récurrents
  recurrenceGroupId String?
  recurrenceIndex   Int?

  // Pré-paiement Stripe
  prepaidPaymentIntentId String?
  prepaidStatus          PrepaidStatus?
  prepaidAmount          Decimal?      @db.Decimal(10, 2)
  prepaidRefundedAt      DateTime?

  slot          AvailabilitySlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  patient       User                @relation("PatientAppointments", fields: [patientId], references: [id])
  transactions  Transaction[]
  medicalNotes  MedicalNote[]
  history       AppointmentHistory[]
  notifications Notification[]
  review        DoctorReview?
  consultations Consultation[]
  questionnaireResponse QuestionnaireResponse?

  @@index([recurrenceGroupId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

model AppointmentHistory {
  id            String   @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  action        String   // CREATED, STATUS_CHANGED, RESCHEDULED, UPDATED, CANCELLED
  oldValue      String?  @db.Text // JSON string of old values
  newValue      String?  @db.Text // JSON string of new values
  description   String?  @db.Text // Human-readable description

  userId        String?  // Who made the change (doctor, patient, admin)
  user          User?    @relation("AppointmentHistoryUser", fields: [userId], references: [id])

  createdAt     DateTime @default(now())

  @@index([appointmentId])
  @@index([userId])
}

model Pharmacy {
  id       String    @id @default(cuid())
  name     String
  city     String
  open     Boolean   @default(true)
  products Product[]
  orders   Order[]
}

model Order {
  id          String      @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patientId   String
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Product {
  id                   String     @id @default(cuid())
  pharmacyId           String
  pharmacy             Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name                 String
  sku                  String     @unique
  price                Decimal    @db.Decimal(10, 2)
  prescriptionRequired Boolean    @default(false)
  inventory            Inventory?
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AvailabilityRule {
  id                String     @id @default(cuid())
  ownerId           String
  ownerType         String     // DOCTOR or HOSPITAL

  // Time parameters
  startDate         DateTime
  endDate           DateTime
  daysOfWeek        Int[]      // [1,2,3,4,5] = Monday-Friday (1=Monday, 7=Sunday)

  // Daily schedule
  startHour         Int        // 8
  endHour           Int        // 18
  slotDurationMins  Int        // 30
  capacity          Int        @default(1)

  // Capacity and appointment types
  allowedKindIds    String[]   // IDs des AppointmentKind acceptés (vide = tous)

  // Exclusions (stored as JSON strings)
  excludedTimes     String[]   // ["12:00-13:00", "14:30-15:00"]

  // Advanced parameters
  minBookingNotice     Int?     // Délai minimum en heures (ex: 24h)
  maxBookingAdvance    Int?     // Délai maximum en jours (ex: 90 jours)
  autoConfirm          Boolean  @default(true)
  allowCancellation    Boolean  @default(true)
  cancellationDeadline Int?     // Heures avant RDV

  // Status
  status            String     @default("ACTIVE")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model FacilityManager {
  id          String    @id @default(cuid())
  userId      String    @unique
  facilityId  String

  // Accès override: docteurs individuels en plus de la structure
  managedDoctorIds String[]  // Array de User IDs (docteurs spécifiques)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([facilityId])
}

model AvailabilityPreference {
  id          String    @id @default(cuid())
  ownerId     String    // User ID du créateur (DOCTOR ou FACILITY_MANAGER)
  ownerType   String    // "DOCTOR" | "FACILITY_MANAGER"

  name        String    // "Semaine standard", "Horaires d'été", etc.
  description String?   @db.Text
  isDefault   Boolean   @default(false)  // Une seule preference peut être par défaut

  // Paramètres de base (horaires et jours)
  daysOfWeek       Int[]    // [1,2,3,4,5]
  startHour        Int      // 8
  endHour          Int      // 18
  slotDurationMins Int      // 30

  // Capacité et types RDV
  capacity            Int      @default(1)
  allowedKindIds      String[] // IDs des AppointmentKind acceptés (vide = tous)

  // Périodes d'exclusion
  excludedTimes       String[] // ["12:00-13:00", "14:30-15:00"]

  // Paramètres avancés
  minBookingNotice    Int?     // Délai minimum en heures (ex: 24h)
  maxBookingAdvance   Int?     // Délai maximum en jours (ex: 90 jours)
  autoConfirm         Boolean  @default(true)
  allowCancellation   Boolean  @default(true)
  cancellationDeadline Int?    // Heures avant RDV

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([ownerType])
}

model DoctorAbsence {
  id          String   @id @default(cuid())
  doctorId    String   // User ID du médecin

  // Période d'absence
  startDate   DateTime
  endDate     DateTime

  // Type d'absence
  type        String   // "VACATION", "SICK_LEAVE", "TRAINING", "PERSONAL", "OTHER"
  reason      String?  @db.Text

  // Options
  blockSlots  Boolean  @default(true)  // Bloquer les créneaux existants
  cancelAppointments Boolean @default(false) // Annuler les RDV existants

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([doctorId])
  @@index([startDate, endDate])
}

model Notification {
  id        String   @id @default(cuid())

  // Destinataire
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Type et contenu
  type      String   // "APPOINTMENT_REMINDER", "APPOINTMENT_CONFIRMED", "APPOINTMENT_CANCELLED", "APPOINTMENT_RESCHEDULED", "GENERAL"
  title     String
  message   String   @db.Text

  // Métadonnées
  relatedAppointmentId String?
  relatedAppointment   Appointment? @relation(fields: [relatedAppointmentId], references: [id], onDelete: Cascade)

  // État
  read      Boolean  @default(false)
  readAt    DateTime?

  // Canaux
  sentViaEmail Boolean @default(false)
  emailSentAt  DateTime?
  sentViaSms   Boolean @default(false)
  smsSentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read])
  @@index([createdAt])
  @@index([relatedAppointmentId])
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  ownerId   String
  ownerType String
  start     DateTime
  end       DateTime
  capacity  Int
  status    String   @default("ACTIVE")

  // rendus optionnels pour faciliter db push
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  appointments Appointment[]
}

model Hospital {
  id   String  @id @default(cuid())
  name String
  city String
  open Boolean @default(true)
}

model DoctorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  specialty    String?
  hospitalType String?
  address      String?
  city         String?
  presentation String?
  formations   String?
  experiences  String?
  languages    String?  // JSON array: ["Français","Anglais","Arabe"]
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Vérification par l'admin
  isVerified   Boolean  @default(false)

  // Paramètres de confirmation des rendez-vous
  autoConfirmPatientBookings Boolean @default(true)

  // many-to-many implicite avec Facility : NE PAS mettre "references" ici
  facilities   Facility[]  @relation("DoctorFacilities")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reviews & Ratings
  reviews      DoctorReview[] @relation("DoctorReviews")

  // Aggregated rating (computed)
  averageRating Float?   @default(0)
  totalReviews  Int      @default(0)
}

model Beneficiary {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("PatientBeneficiaries", fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  birthDate    DateTime?
  relationship String    // enfant, conjoint, parent, autre
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique

  // IDENTITÉ
  civility       Civility?
  birthLastName  String?   // Nom de naissance
  usageLastName  String?   // Nom d'usage
  firstName      String?
  usualFirstName String?
  birthDate      DateTime?
  birthPlace     String?
  birthCountry   String?

  // CONTACT
  phonePrimary   String?
  phoneSecondary String?

  // ADRESSE
  addressLine1   String?
  postalCode     String?
  city           String?
  country        String?

  // COUVERTURE SOCIALE
  socialSecurityNumber String?   // N° sécurité sociale
  insuranceProvider    String?   // Organisme (CNSS, etc.)
  insuranceNumber      String?   // N° adhérent / carte
  insuranceExpiryDate  String?   // Date d'expiration (MM/YY)
  mutualInsurance      String?   // Mutuelle

  // PRÉFÉRENCES NOTIFICATIONS
  smsReminderEnabled   Boolean   @default(true)

  // INFORMATIONS MÉDICALES
  primaryDoctorName String?
  bloodGroup        String?
  heightCm          Int?
  weightKg          Int?

  // DONNÉES ADMINISTRATIVES
  patientCode    String?   @unique  // ex: pat-3
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Civility {
  MR       // Monsieur
  MME      // Madame
  MLLE     // Mademoiselle
}

model MedicalNote {
  id          String   @id @default(cuid())
  patientId   String   // Patient concerné
  doctorId    String   // Médecin auteur de la note

  // Type de note
  type        NoteType @default(OBSERVATION)

  // Contenu
  title       String?
  content     String   @db.Text

  // Métadonnées
  appointmentId String?  // Lien vers un rendez-vous si applicable
  isPrivate     Boolean  @default(false)  // Note privée (visible uniquement par l'auteur)
  tags          String[] // Tags pour catégorisation (ex: ["diabète", "suivi"])

  // Dates
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  patient     User        @relation("PatientNotes", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User        @relation("DoctorNotes", fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
}

enum NoteType {
  OBSERVATION    // Observation générale
  FOLLOW_UP      // Note de suivi
  PRESCRIPTION   // Note de prescription
  DIAGNOSIS      // Diagnostic
  TREATMENT_PLAN // Plan de traitement
  OTHER          // Autre
}

model AppointmentKind {
  id          String  @id @default(cuid())
  name        String
  description String?
  doctorId    String?
  doctor      User?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // Téléconsultation
  isTelemedicine  Boolean @default(false)  // Si true, c'est une téléconsultation
  durationMins    Int     @default(30)     // Durée en minutes
  color           String? // Couleur pour l'affichage

  // Pré-paiement
  requiresPrePayment Boolean  @default(false)
  price              Decimal? @db.Decimal(10, 2)

  // Questionnaire pré-RDV
  questionnaireId String?
  questionnaire   Questionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

model Transaction {
  id           String  @id @default(cuid())
  doctorId     String
  patientId    String
  appointmentId String?

  amount       Decimal           @db.Decimal(10, 2)
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  provider     PaymentProvider
  providerRef  String?           // id du provider (Stripe session id, airtel ref)
  description  String?

  // relations, noms explicites pour lever ambiguïté
  doctor       User   @relation("DoctorTransactions", fields: [doctorId], references: [id])
  patient      User   @relation("PatientTransactions", fields: [patientId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
}

enum TransactionType {
  PAYMENT
  PAYOUT
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Wallet {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  doctor    User             @relation(fields: [doctorId], references: [id])
  movements WalletMovement[]
}

model WalletMovement {
  id        String       @id @default(cuid())
  walletId  String
  amount    Decimal      @db.Decimal(10, 2)
  type      MovementType
  createdAt DateTime     @default(now())
  description String?

  wallet Wallet @relation(fields: [walletId], references: [id])
}

enum MovementType {
  CREDIT
  DEBIT
  COMMISSION
  WITHDRAWAL
}

enum PaymentProvider {
  AIRTEL_MONEY
  STRIPE
}

// ==========================================
// SYSTÈME DE FACTURATION
// ==========================================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique  // ex: FAC-2024-0001

  // Parties
  doctorId      String
  patientId     String
  appointmentId String?       // Lié à un RDV si applicable

  // Montants
  subtotal      Decimal       @db.Decimal(10, 2)  // Montant HT
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)  // Taux de TVA (ex: 20.00)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)  // Montant TVA
  total         Decimal       @db.Decimal(10, 2)  // Montant TTC

  // Statut
  status        InvoiceStatus @default(DRAFT)

  // Dates
  issueDate     DateTime      @default(now())
  dueDate       DateTime?     // Date d'échéance
  paidAt        DateTime?     // Date de paiement

  // Infos complémentaires
  notes         String?       @db.Text
  paymentMethod String?       // Mode de paiement utilisé

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  doctor        User          @relation("DoctorInvoices", fields: [doctorId], references: [id])
  patient       User          @relation("PatientInvoices", fields: [patientId], references: [id])
  items         InvoiceItem[]

  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum InvoiceStatus {
  DRAFT       // Brouillon
  SENT        // Envoyée au patient
  PAID        // Payée
  CANCELLED   // Annulée
  OVERDUE     // En retard de paiement
}

// ==========================================
// SYSTÈME DE PRESCRIPTIONS
// ==========================================

model Prescription {
  id                String        @id @default(cuid())
  prescriptionNumber String       @unique  // ex: ORD-2024-0001

  // Parties
  doctorId          String
  patientId         String
  appointmentId     String?       // Lié à un RDV si applicable

  // Dates
  issueDate         DateTime      @default(now())
  validUntil        DateTime?     // Date de validité

  // Informations médicales
  diagnosis         String?       @db.Text  // Diagnostic / Motif
  generalInstructions String?     @db.Text  // Instructions générales

  // Statut
  status            PrescriptionStatus @default(DRAFT)

  // Métadonnées
  notes             String?       @db.Text
  renewalCount      Int           @default(0)  // Nombre de renouvellements
  renewedFromId     String?       // ID de la prescription originale si c'est un renouvellement

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  doctor            User          @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  patient           User          @relation("PatientPrescriptions", fields: [patientId], references: [id])
  medications       PrescriptionMedication[]

  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([issueDate])
}

model PrescriptionMedication {
  id              String       @id @default(cuid())
  prescriptionId  String

  // Médicament
  name            String       // Nom du médicament
  dosage          String?      // Ex: "500mg", "10mg/ml"
  frequency       String?      // Ex: "2 fois par jour", "1 le matin"
  duration        String?      // Ex: "7 jours", "1 semaine"
  instructions    String?      @db.Text  // Instructions spéciales
  quantity        Int?         // Quantité à délivrer

  createdAt       DateTime     @default(now())

  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

enum PrescriptionStatus {
  DRAFT       // Brouillon
  ACTIVE      // Active (signée et délivrée)
  EXPIRED     // Expirée
  CANCELLED   // Annulée
  DISPENSED   // Délivrée en pharmacie
}

model Facility {
  id          String    @id @default(cuid())
  name        String
  type        FacilityType
  description String?   @db.Text
  address     String?
  city        String?
  geoLat      Float?
  geoLng      Float?
  phone       String?
  email       String?
  website     String?
  services    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // many-to-many implicite : côté Facility on doit garder juste Facility[]
  doctors      DoctorProfile[]  @relation("DoctorFacilities")
  managers     FacilityManager[]
  contracts    Contract[]       @relation("FacilityContracts")
  appointments Appointment[]
}

enum FacilityType {
  CLINIC
  CHU
  POLYCLINIC
  CENTER
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "google", "facebook"
  providerAccountId String   // ID from the provider
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ==========================================
// SYSTÈME DE FAVORIS - Médecins préférés
// ==========================================

model FavoriteDoctor {
  id        String   @id @default(cuid())
  patientId String   // Patient qui a ajouté le favori
  doctorId  String   // Médecin ajouté en favori

  createdAt DateTime @default(now())

  patient   User     @relation("PatientFavorites", fields: [patientId], references: [id], onDelete: Cascade)
  doctor    User     @relation("DoctorFavorites", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])  // Un patient ne peut ajouter un médecin qu'une seule fois
  @@index([patientId])
  @@index([doctorId])
}

// ==========================================
// HISTORIQUE MÉDICAL - Documents médicaux
// ==========================================

model MedicalDocument {
  id          String   @id @default(cuid())
  patientId   String   // Patient propriétaire du document

  // Informations du fichier
  fileName    String
  fileUrl     String   // URL du fichier stocké (S3, Cloudinary, etc.)
  fileType    String   // MIME type (application/pdf, image/jpeg, etc.)
  fileSize    Int      // Taille en bytes

  // Classification
  category    DocumentCategory @default(OTHER)
  title       String?
  description String?  @db.Text

  // Métadonnées
  documentDate DateTime?  // Date du document (ex: date de l'ordonnance)
  doctorId     String?    // Médecin associé (si applicable)
  appointmentId String?   // Rendez-vous associé (si applicable)

  // Confidentialité
  isPrivate   Boolean  @default(false)  // Si true, seul le patient peut voir
  sharedWith  String[] // IDs des médecins avec qui le document est partagé

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     User     @relation("PatientDocuments", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([category])
  @@index([documentDate])
}

enum DocumentCategory {
  PRESCRIPTION      // Ordonnance
  LAB_RESULT        // Résultat d'analyse
  IMAGING           // Imagerie (radio, IRM, scanner)
  MEDICAL_REPORT    // Compte-rendu médical
  VACCINATION       // Carnet de vaccination
  CERTIFICATE       // Certificat médical
  INSURANCE         // Document assurance
  OTHER             // Autre
}

// ==========================================
// SYSTÈME DE TÂCHES - Todo list médecin
// ==========================================

model Task {
  id          String     @id @default(cuid())
  doctorId    String     // Médecin propriétaire de la tâche
  patientId   String?    // Patient associé (optionnel)

  // Contenu
  title       String
  description String?    @db.Text

  // Priorité et statut
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)

  // Dates
  dueDate     DateTime?  // Date d'échéance
  completedAt DateTime?  // Date de completion

  // Catégorisation
  category    TaskCategory @default(OTHER)
  tags        String[]   // Tags personnalisés

  // Rappel
  reminderAt  DateTime?  // Rappel programmé

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  doctor      User       @relation("DoctorTasks", fields: [doctorId], references: [id], onDelete: Cascade)
  patient     User?      @relation("PatientTasks", fields: [patientId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO        // À faire
  IN_PROGRESS // En cours
  DONE        // Terminé
  CANCELLED   // Annulé
}

enum TaskCategory {
  FOLLOW_UP       // Suivi patient
  CALL            // Appel à passer
  PRESCRIPTION    // Prescription à renouveler
  LAB_REVIEW      // Résultats à consulter
  ADMIN           // Tâche administrative
  APPOINTMENT     // Lié à un RDV
  OTHER           // Autre
}

// ==========================================
// DOSSIER PATIENT COMPLET
// ==========================================

// Antécédents médicaux
model MedicalHistory {
  id          String   @id @default(cuid())
  patientId   String

  // Type d'antécédent
  category    MedicalHistoryCategory

  // Détails
  title       String              // Ex: "Diabète type 2", "Hernie inguinale"
  description String?  @db.Text   // Description détaillée
  severity    String?             // Gravité (légère, modérée, sévère)

  // Dates
  diagnosedAt DateTime?           // Date de diagnostic
  resolvedAt  DateTime?           // Date de guérison (si applicable)

  // Statut
  isActive    Boolean  @default(true)  // Toujours actif ou résolu

  // Métadonnées
  doctorId    String?             // Médecin qui a enregistré
  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     User     @relation("PatientMedicalHistory", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User?    @relation("DoctorMedicalHistory", fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([category])
  @@index([isActive])
}

enum MedicalHistoryCategory {
  ALLERGY            // Allergies
  MEDICAL            // Antécédents médicaux
  SURGICAL           // Antécédents chirurgicaux
  FAMILY             // Antécédents familiaux
  CARDIOVASCULAR     // Appareil cardiovasculaire
  LIFESTYLE          // Mode de vie (tabac, alcool, etc.)
}

// Vaccinations
model Vaccination {
  id            String   @id @default(cuid())
  patientId     String

  // Vaccin
  vaccineName   String              // Ex: "Vaccin anti-grippal", "DTP"
  vaccineType   String?             // Type/Marque
  lotNumber     String?             // Numéro de lot
  manufacturer  String?             // Fabricant

  // Administration
  doseNumber    Int      @default(1)  // Numéro de dose (1ère, 2ème, rappel)
  injectionSite String?             // Site d'injection (bras gauche, cuisse droite, etc.)

  // Dates
  administeredAt DateTime           // Date d'administration
  nextDoseAt     DateTime?          // Prochain rappel prévu
  expiresAt      DateTime?          // Date d'expiration du vaccin

  // Professionnel de santé
  administeredBy String?            // Nom du praticien
  facilityName   String?            // Établissement

  // Notes
  notes         String?  @db.Text
  sideEffects   String?  @db.Text   // Effets secondaires observés

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       User     @relation("PatientVaccinations", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([administeredAt])
  @@index([vaccineName])
}

// Traitements en cours
model Treatment {
  id            String   @id @default(cuid())
  patientId     String
  doctorId      String?            // Médecin prescripteur

  // Médicament
  medicationName String            // Nom du médicament
  genericName    String?           // Nom générique
  dosage         String            // Ex: "500mg", "10mg/ml"

  // Posologie
  frequency      String            // Ex: "2 fois par jour", "1 le matin"
  route          String?           // Voie d'administration (orale, injectable, etc.)
  instructions   String? @db.Text  // Instructions spéciales

  // Durée
  startDate      DateTime          // Date de début
  endDate        DateTime?         // Date de fin prévue

  // Statut
  status         TreatmentStatus @default(ACTIVE)

  // Raison
  indication     String? @db.Text  // Indication (pourquoi ce traitement)

  // Métadonnées
  prescriptionId String?           // Référence ordonnance
  renewalCount   Int      @default(0)  // Nombre de renouvellements

  notes          String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        User     @relation("PatientTreatments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor         User?    @relation("DoctorTreatments", fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([status])
  @@index([startDate])
}

enum TreatmentStatus {
  ACTIVE      // En cours
  PAUSED      // Suspendu temporairement
  STOPPED     // Arrêté
  COMPLETED   // Terminé
}

// Mesures biométriques
model BiometricMeasurement {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String?  // Médecin qui a pris la mesure (optionnel si auto-mesure)

  // Type de mesure
  type        BiometricType

  // Valeurs
  value       Float               // Valeur principale
  valueSecondary Float?           // Valeur secondaire (ex: tension diastolique)
  unit        String              // Unité (kg, cm, mmHg, °C, etc.)

  // Contexte
  measuredAt  DateTime @default(now())
  location    String?             // Lieu de mesure
  method      String?             // Méthode de mesure

  // Notes
  notes       String?  @db.Text
  isAbnormal  Boolean  @default(false)  // Valeur anormale

  createdAt   DateTime @default(now())

  patient     User     @relation("PatientBiometrics", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User?    @relation("DoctorBiometrics", fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([type])
  @@index([measuredAt])
}

enum BiometricType {
  WEIGHT              // Poids (kg)
  HEIGHT              // Taille (cm)
  BLOOD_PRESSURE      // Tension artérielle (mmHg)
  HEART_RATE          // Fréquence cardiaque (bpm)
  TEMPERATURE         // Température (°C)
  OXYGEN_SATURATION   // Saturation O2 (%)
  BLOOD_GLUCOSE       // Glycémie (g/L ou mg/dL)
  BMI                 // IMC
  WAIST_CIRCUMFERENCE // Tour de taille (cm)
  OTHER               // Autre
}

// Observations cliniques
model ClinicalObservation {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String

  // Contenu
  title       String?
  content     String   @db.Text    // Contenu de l'observation

  // Catégorie
  category    ObservationCategory @default(GENERAL)

  // Urgence
  isUrgent    Boolean  @default(false)

  // Lien avec consultation
  appointmentId String?

  // Date de l'observation
  observedAt  DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     User     @relation("PatientObservations", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User     @relation("DoctorObservations", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([observedAt])
  @@index([category])
}

enum ObservationCategory {
  GENERAL             // Observation générale
  VITAL_SIGNS         // Signes vitaux
  SYMPTOMS            // Symptômes
  EXAMINATION         // Examen clinique
  EVOLUTION           // Évolution/Suivi
  ALERT               // Alerte médicale
}

// Résultats de laboratoire
model LabResult {
  id          String   @id @default(cuid())
  patientId   String

  // Test
  testName    String              // Nom de l'analyse
  testCode    String?             // Code du test
  category    LabCategory @default(OTHER)

  // Résultat
  value       String              // Valeur (peut être texte ou nombre)
  unit        String?             // Unité
  normalRange String?             // Plage normale (ex: "4.0-6.0")

  // Interprétation
  interpretation String?          // Normal, Anormal, Critique
  isAbnormal  Boolean  @default(false)

  // Dates
  sampleDate  DateTime?           // Date du prélèvement
  resultDate  DateTime            // Date du résultat

  // Laboratoire
  labName     String?             // Nom du laboratoire
  labRef      String?             // Référence labo

  // Médecin prescripteur
  doctorId    String?

  notes       String?  @db.Text

  createdAt   DateTime @default(now())

  patient     User     @relation("PatientLabResults", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User?    @relation("DoctorLabResults", fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([testName])
  @@index([resultDate])
  @@index([category])
}

enum LabCategory {
  HEMATOLOGY      // Hématologie
  BIOCHEMISTRY    // Biochimie
  IMMUNOLOGY      // Immunologie
  MICROBIOLOGY    // Microbiologie
  URINALYSIS      // Analyse d'urine
  HORMONES        // Hormones
  OTHER           // Autre
}

// Contacts d'urgence
model EmergencyContact {
  id          String   @id @default(cuid())
  patientId   String

  // Identité
  fullName    String
  relationship String             // Parent, Conjoint, Ami, etc.

  // Contact
  phone       String
  phoneSecondary String?
  email       String?

  // Priorité
  isPrimary   Boolean  @default(false)  // Contact principal
  priority    Int      @default(1)      // Ordre de priorité

  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     User     @relation("PatientEmergencyContacts", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// Consentements patient
model PatientConsent {
  id          String   @id @default(cuid())
  patientId   String

  // Type de consentement
  type        ConsentType

  // Statut
  granted     Boolean  @default(false)

  // Dates
  grantedAt   DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime?           // Expiration du consentement

  // Signatures
  signedAt    DateTime?
  ipAddress   String?             // IP lors de la signature

  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     User     @relation("PatientConsents", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, type])
  @@index([patientId])
  @@index([type])
}

enum ConsentType {
  CARE                // Consentement aux soins
  DATA_SHARING        // Partage de données médicales
  TELECONSULTATION    // Téléconsultation
  EMAIL_COMMUNICATION // Communications électroniques
  RESEARCH            // Recherche clinique
}

// ============================================
// REVIEWS & RATINGS
// ============================================

model DoctorReview {
  id            String   @id @default(cuid())
  doctorId      String
  patientId     String
  appointmentId String?  @unique  // Optionnel, lié à un RDV spécifique

  // Notes (1-5)
  overallRating     Int      // Note globale
  punctualityRating Int?     // Ponctualité
  professionalismRating Int? // Professionnalisme
  communicationRating Int?   // Communication

  // Commentaire
  title         String?
  comment       String?  @db.Text

  // Modération
  isPublic      Boolean  @default(true)
  isVerified    Boolean  @default(false)  // Vérifié par le système
  isApproved    Boolean  @default(true)   // Approuvé par modération
  moderatedAt   DateTime?
  moderationNote String?

  // Réponse du médecin
  doctorResponse    String?  @db.Text
  doctorRespondedAt DateTime?

  // Signalement
  reportCount   Int      @default(0)
  isReported    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor        DoctorProfile @relation("DoctorReviews", fields: [doctorId], references: [id], onDelete: Cascade)
  patient       User          @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([doctorId, patientId, appointmentId])
  @@index([doctorId])
  @@index([patientId])
  @@index([overallRating])
}

// ============================================
// HEALTH RECORDS (Dossier Médical Complet)
// ============================================

model HealthRecord {
  id          String   @id @default(cuid())
  patientId   String   @unique

  // Informations générales
  bloodType       String?   // A+, A-, B+, B-, AB+, AB-, O+, O-
  rhesus          String?
  heightCm        Float?
  weightKg        Float?

  // Allergies
  allergies       String[]  // Liste des allergies
  allergyDetails  String?   @db.Text  // Détails JSON

  // Antécédents
  medicalHistory      String?  @db.Text  // JSON des antécédents médicaux
  surgicalHistory     String?  @db.Text  // JSON des chirurgies
  familyHistory       String?  @db.Text  // JSON des antécédents familiaux

  // Mode de vie
  smokingStatus       String?  // NEVER, FORMER, CURRENT
  alcoholConsumption  String?  // NONE, OCCASIONAL, MODERATE, HEAVY
  physicalActivity    String?  // SEDENTARY, LIGHT, MODERATE, ACTIVE

  // Traitements en cours
  currentMedications  String?  @db.Text  // JSON

  // Vaccinations
  vaccinationRecord   String?  @db.Text  // JSON

  // Documents
  notes               String?  @db.Text

  lastUpdatedBy   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         User     @relation("PatientHealthRecord", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// ============================================
// TWO-FACTOR AUTHENTICATION
// ============================================

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique

  // TOTP (Time-based One-Time Password)
  secret      String?           // Encrypted TOTP secret
  isEnabled   Boolean  @default(false)

  // Backup codes
  backupCodes String[]          // Hashed backup codes

  // SMS/Email verification
  phoneNumber String?
  phoneVerified Boolean @default(false)

  // Recovery
  recoveryEmail     String?
  recoveryEmailVerified Boolean @default(false)

  // Audit
  lastUsedAt        DateTime?
  failedAttempts    Int      @default(0)
  lockedUntil       DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// WEBHOOK SUBSCRIPTIONS
// ============================================

model WebhookSubscription {
  id          String   @id @default(cuid())
  userId      String

  // Configuration
  url         String           // URL du webhook
  secret      String           // Secret pour signature HMAC

  // Événements souscrits
  events      String[]         // APPOINTMENT_CREATED, APPOINTMENT_CANCELLED, etc.

  // Status
  isActive    Boolean  @default(true)

  // Statistiques
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  lastTriggeredAt DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  lastError       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([userId])
  @@index([isActive])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  subscriptionId  String

  // Payload
  event           String
  payload         String   @db.Text  // JSON

  // Delivery status
  status          String   // PENDING, SUCCESS, FAILED
  statusCode      Int?
  responseBody    String?  @db.Text
  errorMessage    String?  @db.Text

  // Timing
  attemptCount    Int      @default(1)
  nextRetryAt     DateTime?
  deliveredAt     DateTime?

  createdAt       DateTime @default(now())

  subscription    WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// TEAM MANAGEMENT
// ==========================================

model TeamMember {
  id          String   @id @default(cuid())
  ownerId     String   // Le médecin/propriétaire de l'équipe
  userId      String?  // L'utilisateur (null si invitation en attente)

  // Informations membre
  email       String
  fullName    String
  phone       String?
  role        TeamRole
  status      TeamMemberStatus @default(PENDING)

  // Gestionnaire de l'établissement (droits élargis sans changer de rôle)
  isManager   Boolean  @default(false)

  // Permissions (JSON array of permission IDs)
  permissions String[]

  // Dates
  invitedAt   DateTime @default(now())
  joinedAt    DateTime?
  lastActiveAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, email])
  @@index([ownerId])
  @@index([userId])
  @@index([status])
}

enum TeamRole {
  SECRETARY
  NURSE
  ASSISTANT
  INTERN
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  INACTIVE
  REVOKED
}

// ==========================================
// CALENDAR SYNC
// ==========================================

model CalendarConnection {
  id          String   @id @default(cuid())
  userId      String

  // Provider info
  provider    CalendarProvider
  providerAccountId String
  providerEmail     String?

  // OAuth tokens
  accessToken     String   @db.Text
  refreshToken    String?  @db.Text
  tokenExpiresAt  DateTime?

  // Sync settings
  isActive        Boolean  @default(true)
  syncDirection   SyncDirection @default(BOTH)
  showBusyOnly    Boolean  @default(false)
  autoSync        Boolean  @default(true)
  syncIntervalMins Int     @default(15)

  // Selected calendars (JSON array of calendar IDs)
  selectedCalendars String[]

  // Status
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  errorMessage    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  APPLE
}

enum SyncDirection {
  IMPORT
  EXPORT
  BOTH
}

// ==========================================
// PRESCRIPTION TEMPLATES
// ==========================================

model PrescriptionTemplate {
  id          String   @id @default(cuid())
  doctorId    String

  // Template info
  name        String
  description String?
  category    String   // general, cardio, gastro, etc.

  // Notes
  notes       String?  @db.Text

  // Usage tracking
  isFavorite  Boolean  @default(false)
  usageCount  Int      @default(0)
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medications PrescriptionTemplateMedication[]

  @@index([doctorId])
  @@index([category])
  @@index([isFavorite])
}

model PrescriptionTemplateMedication {
  id          String   @id @default(cuid())
  templateId  String

  // Medication info
  name        String
  dosage      String
  frequency   String
  duration    String
  instructions String?

  // Order
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())

  template    PrescriptionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// ==========================================
// ANALYTICS & GOALS
// ==========================================

model AnalyticsGoal {
  id          String   @id @default(cuid())
  userId      String

  // Period
  year        Int
  month       Int      // 1-12, 0 for yearly goal

  // Goals
  revenueGoal         Float?
  appointmentsGoal    Int?
  newPatientsGoal     Int?

  // Actuals (cached for performance)
  revenueActual       Float    @default(0)
  appointmentsActual  Int      @default(0)
  newPatientsActual   Int      @default(0)

  // Metrics (cached)
  retentionRate       Float?
  noShowRate          Float?
  cancellationRate    Float?

  lastCalculatedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
  @@index([year, month])
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  userId      String

  // Period
  date        DateTime @db.Date
  periodType  AnalyticsPeriodType

  // Metrics
  totalPatients       Int      @default(0)
  newPatients         Int      @default(0)
  returningPatients   Int      @default(0)
  totalAppointments   Int      @default(0)
  completedAppointments Int    @default(0)
  cancelledAppointments Int    @default(0)
  noShows             Int      @default(0)
  totalRevenue        Float    @default(0)
  avgConsultationTime Float?

  createdAt   DateTime @default(now())

  @@unique([userId, date, periodType])
  @@index([userId])
  @@index([date])
  @@index([periodType])
}

enum AnalyticsPeriodType {
  DAILY
  WEEKLY
  MONTHLY
}

// ============================================
// CONSULTATIONS
// ============================================

model Consultation {
  id            String              @id @default(cuid())
  patientId     String
  doctorId      String
  appointmentId String?

  // Type de consultation
  mode          String?             @default("PRESENTIEL") // "PRESENTIEL" | "TELECONSULTATION"

  // Contenu de la consultation
  motif           String?
  interrogatoire  String?           @db.Text
  examen          String?           @db.Text
  notes           String?           @db.Text

  // Statut et dates
  status        ConsultationStatus  @default(ACTIVE)
  startedAt     DateTime            @default(now())
  endedAt       DateTime?

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  patient       User                @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User                @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: Cascade)
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
}

enum ConsultationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============================================
// MESSAGES / CONVERSATIONS
// ============================================

model Conversation {
  id             String    @id @default(cuid())
  participant1Id String
  participant2Id String

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  participant1   User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
}

model Message {
  id              String      @id @default(cuid())
  conversationId  String
  senderId        String
  content         String      @db.Text
  type            MessageType @default(TEXT)
  read            Boolean     @default(false)

  createdAt       DateTime    @default(now())

  // Relations
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

// ==========================================
// ADMIN AUDIT LOG
// ==========================================

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // e.g. CREATE_USER, SUSPEND_USER, UPDATE_USER, CANCEL_APPOINTMENT
  targetId   String?
  targetType String?  // USER, APPOINTMENT, SETTING, FACILITY
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

model AuthLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("UserAuthLogs", fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?  // INVALID_PASSWORD, USER_NOT_FOUND, ACCOUNT_INACTIVE, 2FA_PENDING, SUCCESS
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([success])
  @@index([email])
}

// ==========================================
// PLATFORM SETTINGS
// ==========================================

model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  label     String?
  updatedAt DateTime @updatedAt
}

// ==========================================
// CONTRACTS
// ==========================================

model Contract {
  id          String         @id @default(cuid())
  title       String
  type        ContractType
  status      ContractStatus @default(DRAFT)
  entityName  String
  userId      String?
  facilityId  String?
  startDate   DateTime
  endDate     DateTime?
  value       Float?
  currency    String         @default("XAF")
  terms       String?        @db.Text
  notes       String?        @db.Text
  signedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User?          @relation("UserContracts", fields: [userId], references: [id], onDelete: SetNull)
  facility    Facility?      @relation("FacilityContracts", fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum ContractType {
  DOCTOR
  HOSPITAL
  CHU
  CLINIC
  PHARMACY
  PARTNER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  SUSPENDED
}

// ==========================================
// SUPPORT TICKETS
// ==========================================

model SupportTicket {
  id          String          @id @default(cuid())
  title       String
  description String          @db.Text
  status      TicketStatus    @default(OPEN)
  priority    TicketPriority  @default(MEDIUM)
  category    String?
  authorId    String
  authorType  String          // PATIENT or DOCTOR
  assignedTo  String?
  response    String?         @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  author      User            @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorType])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Referrals ────────────────────────────────────────────────────────────────

model Referral {
  id            String          @id @default(cuid())
  patientId     String
  fromDoctorId  String
  toDoctorId    String
  reason        String          @db.Text
  notes         String?         @db.Text
  urgency       ReferralUrgency @default(NORMAL)
  status        ReferralStatus  @default(PENDING)
  response      String?         @db.Text
  respondedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  patient    User @relation("ReferralPatient",  fields: [patientId],    references: [id])
  fromDoctor User @relation("ReferralFrom",     fields: [fromDoctorId], references: [id])
  toDoctor   User @relation("ReferralTo",       fields: [toDoctorId],   references: [id])

  @@index([patientId])
  @@index([fromDoctorId])
  @@index([toDoctorId])
  @@index([status])
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum ReferralUrgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─── Medical Correspondences ──────────────────────────────────────────────────

model MedicalCorrespondence {
  id          String                 @id @default(cuid())
  senderId    String
  recipientId String
  patientId   String?
  category    CorrespondenceCategory @default(AUTRE)
  subject     String
  content     String                 @db.Text
  isRead      Boolean                @default(false)
  readAt      DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  sender    User  @relation("CorrespondenceSender",   fields: [senderId],    references: [id])
  recipient User  @relation("CorrespondenceRecipient", fields: [recipientId], references: [id])
  patient   User? @relation("CorrespondencePatient",  fields: [patientId],   references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([patientId])
}

enum CorrespondenceCategory {
  COMPTE_RENDU
  DEMANDE_AVIS
  REPONSE_AVIS
  TRANSFERT
  AUTRE
}

// ─── Liste d'attente ──────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String          @id @default(cuid())
  doctorId  String
  doctor    User            @relation("WaitlistDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   User            @relation("WaitlistPatient", fields: [patientId], references: [id], onDelete: Cascade)
  kindId    String?
  date      DateTime        // Jour souhaité (heure ignorée)
  position  Int             @default(0)
  status    WaitlistStatus  @default(ACTIVE)
  notifiedAt DateTime?
  createdAt DateTime        @default(now())

  @@index([doctorId, date])
  @@index([patientId])
  @@index([status])
}

enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  BOOKED
  EXPIRED
}

// ─── Questionnaires pré-RDV ───────────────────────────────────────────────────

enum QuestionType {
  TEXT
  TEXTAREA
  YES_NO
  SCALE
  MULTIPLE_CHOICE
}

model Questionnaire {
  id          String     @id @default(cuid())
  doctorId    String
  doctor      User       @relation("DoctorQuestionnaires", fields: [doctorId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]
  kinds       AppointmentKind[]
  responses   QuestionnaireResponse[]

  @@index([doctorId])
}

model Question {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  text            String
  type            QuestionType  @default(TEXT)
  options         String?       // JSON array for MULTIPLE_CHOICE
  required        Boolean       @default(false)
  order           Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([questionnaireId])
}

model QuestionnaireResponse {
  id              String        @id @default(cuid())
  appointmentId   String        @unique
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])
  answers         Json          // { questionId: answer }
  submittedAt     DateTime      @default(now())

  @@index([questionnaireId])
}

// ─── Pré-paiement ─────────────────────────────────────────────────────────────

enum PrepaidStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// ==========================================
// SIGNALEMENTS & BLOCAGES
// ==========================================

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReportsMade",     fields: [reporterId], references: [id], onDelete: Cascade)
  targetId       String
  target         User         @relation("ReportsReceived", fields: [targetId],   references: [id], onDelete: Cascade)
  type           ReportType
  reason         ReportReason
  details        String?      @db.Text
  status         ReportStatus @default(PENDING)
  conversationId String?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime     @default(now())

  @@index([reporterId])
  @@index([targetId])
  @@index([status])
  @@index([createdAt])
}

enum ReportType {
  USER
  CONVERSATION
  MESSAGE
}

enum ReportReason {
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SPAM
  FAKE_PROFILE
  UNPROFESSIONAL_CONDUCT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade",     fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
