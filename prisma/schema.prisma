generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  password           String
  role               Role
  fullName           String?
  avatarUrl          String?
  phone              String?
  sex                String? // ou enum si tu préfères
  birthdate          DateTime?
  city               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  doctorProfile      DoctorProfile?
  appointments       Appointment[]     @relation("PatientAppointments")
  appointmentKinds   AppointmentKind[]
  // 🔹 Transactions où l'utilisateur est DOCTOR
  doctorTransactions Transaction[]     @relation("DoctorTransactions")

  // 🔹 Transactions où l'utilisateur est PATIENT
  patientTransactions Transaction[] @relation("PatientTransactions")
  wallet              Wallet?
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  HOSPITAL
  ADMIN
}

model Appointment {
  id        String            @id @default(cuid())
  slotId    String
  patientId String
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  type      String?
  // nouveau :
  kindId    String?
  kind      AppointmentKind?  @relation(fields: [kindId], references: [id])

  slot         AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  patient      User             @relation("PatientAppointments", fields: [patientId], references: [id])
  transactions Transaction[]
}

enum AppointmentType {
  CONSULTATION
  PREMIERE_CONSULTATION
  SUIVI
  URGENCE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

model Pharmacy {
  id       String    @id @default(cuid())
  name     String
  city     String
  open     Boolean   @default(true)
  products Product[]
  orders   Order[]
}

model Order {
  id          String      @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patientId   String
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Product {
  id                   String     @id @default(cuid())
  pharmacyId           String
  pharmacy             Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name                 String
  sku                  String     @unique
  price                Decimal    @db.Decimal(10, 2)
  prescriptionRequired Boolean    @default(false)
  inventory            Inventory?
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AvailabilitySlot {
  id      String @id @default(cuid())
  ownerId String

  // ❗ on laisse en String parce qu'actuellement ta table a déjà une colonne ownerType en texte
  ownerType String

  start    DateTime
  end      DateTime
  capacity Int
  status   String   @default("ACTIVE")

  // ❗ on les met OPTIONNELLES pour que Prisma puisse pousser sans rager
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  appointments Appointment[]
}

enum OwnerType {
  DOCTOR
  HOSPITAL
}

enum SlotStatus {
  ACTIVE
  INACTIVE
}

model Hospital {
  id   String  @id @default(cuid())
  name String
  city String
  open Boolean @default(true)
}

model DoctorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  specialty    String?
  hospitalType String? // clinique privée, CHU, cabinet...
  address      String?
  city         String?
  presentation String? // texte libre: "Cardiologue depuis 12 ans..."
  formations   String? // JSON ou texte, on reste en texte pour l’instant
  experiences  String? // idem
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppointmentKind {
  id          String  @id @default(cuid())
  name        String // "Première consultation", "Suivi", ...
  description String?
  // si NULL → type global (admin)
  doctorId    String?
  doctor      User?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

model Transaction {
  id            String  @id @default(cuid())
  doctorId      String
  patientId     String
  appointmentId String?

  amount    Decimal           @db.Decimal(10, 2)
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())

  // 🔹 relation vers le docteur
  doctor User @relation("DoctorTransactions", fields: [doctorId], references: [id])

  // 🔹 relation vers le patient
  patient User @relation("PatientTransactions", fields: [patientId], references: [id])

  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  description String? // "Consultation #1234", "Retrait Stripe", etc.
}

enum TransactionType {
  PAYMENT // paiement pour une consultation / abonnement
  PAYOUT // retrait vers le compte bancaire du docteur
  REFUND // remboursement éventuel
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Wallet {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  doctor    User             @relation(fields: [doctorId], references: [id])
  movements WalletMovement[]
}

model WalletMovement {
  id        String       @id @default(cuid())
  walletId  String
  amount    Decimal      @db.Decimal(10, 2)
  type      MovementType
  createdAt DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}

enum MovementType {
  CREDIT
  DEBIT
  COMMISSION
  WITHDRAWAL
}
