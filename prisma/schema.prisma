generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  password           String?           // Optionnel pour OAuth users
  role               Role
  fullName           String?
  avatarUrl          String?
  phone              String?
  sex                String?
  birthdate          DateTime?
  city               String?
  emailVerified      Boolean           @default(false)
  verificationToken  String?           @unique
  tokenExpiry        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  doctorProfile      DoctorProfile?
  patientProfile     PatientProfile?
  appointments       Appointment[]     @relation("PatientAppointments")
  appointmentKinds   AppointmentKind[]
  accounts           Account[]         // OAuth accounts

  // Medical Notes relations
  patientNotes       MedicalNote[]     @relation("PatientNotes")
  doctorNotes        MedicalNote[]     @relation("DoctorNotes")

  // Transactions relations (nommées pour éviter ambiguïté)
  doctorTransactions  Transaction[]     @relation("DoctorTransactions")
  patientTransactions Transaction[]     @relation("PatientTransactions")
  wallet              Wallet?
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  HOSPITAL
  ADMIN
}

model Appointment {
  id         String            @id @default(cuid())
  slotId     String
  patientId  String
  status     AppointmentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime          @default(now())
  type       String?
  kindId     String?
  kind       AppointmentKind?  @relation(fields: [kindId], references: [id])

  slot         AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  patient      User             @relation("PatientAppointments", fields: [patientId], references: [id])
  transactions Transaction[]
  medicalNotes MedicalNote[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

model Pharmacy {
  id       String    @id @default(cuid())
  name     String
  city     String
  open     Boolean   @default(true)
  products Product[]
  orders   Order[]
}

model Order {
  id          String      @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patientId   String
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Product {
  id                   String     @id @default(cuid())
  pharmacyId           String
  pharmacy             Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name                 String
  sku                  String     @unique
  price                Decimal    @db.Decimal(10, 2)
  prescriptionRequired Boolean    @default(false)
  inventory            Inventory?
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  ownerId   String
  ownerType String
  start     DateTime
  end       DateTime
  capacity  Int
  status    String   @default("ACTIVE")

  // rendus optionnels pour faciliter db push
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  appointments Appointment[]
}

model Hospital {
  id   String  @id @default(cuid())
  name String
  city String
  open Boolean @default(true)
}

model DoctorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  specialty    String?
  hospitalType String?
  address      String?
  city         String?
  presentation String?
  formations   String?
  experiences  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // many-to-many implicite avec Facility : NE PAS mettre "references" ici
  facilities   Facility[]  @relation("DoctorFacilities")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique

  // IDENTITÉ
  civility       Civility?
  birthLastName  String?   // Nom de naissance
  usageLastName  String?   // Nom d'usage
  firstName      String?
  usualFirstName String?
  birthDate      DateTime?
  birthPlace     String?
  birthCountry   String?

  // CONTACT
  phonePrimary   String?
  phoneSecondary String?

  // ADRESSE
  addressLine1   String?
  postalCode     String?
  city           String?
  country        String?

  // COUVERTURE SOCIALE
  socialSecurityNumber String?   // N° sécurité sociale
  insuranceProvider    String?   // Organisme
  mutualInsurance      String?   // Mutuelle

  // INFORMATIONS MÉDICALES
  primaryDoctorName String?
  bloodGroup        String?
  heightCm          Int?
  weightKg          Int?

  // DONNÉES ADMINISTRATIVES
  patientCode    String?   @unique  // ex: pat-3
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Civility {
  MR       // Monsieur
  MME      // Madame
  MLLE     // Mademoiselle
}

model MedicalNote {
  id          String   @id @default(cuid())
  patientId   String   // Patient concerné
  doctorId    String   // Médecin auteur de la note

  // Type de note
  type        NoteType @default(OBSERVATION)

  // Contenu
  title       String?
  content     String   @db.Text

  // Métadonnées
  appointmentId String?  // Lien vers un rendez-vous si applicable
  isPrivate     Boolean  @default(false)  // Note privée (visible uniquement par l'auteur)
  tags          String[] // Tags pour catégorisation (ex: ["diabète", "suivi"])

  // Dates
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  patient     User        @relation("PatientNotes", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User        @relation("DoctorNotes", fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
}

enum NoteType {
  OBSERVATION    // Observation générale
  FOLLOW_UP      // Note de suivi
  PRESCRIPTION   // Note de prescription
  DIAGNOSIS      // Diagnostic
  TREATMENT_PLAN // Plan de traitement
  OTHER          // Autre
}

model AppointmentKind {
  id          String  @id @default(cuid())
  name        String
  description String?
  doctorId    String?
  doctor      User?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

model Transaction {
  id           String  @id @default(cuid())
  doctorId     String
  patientId    String
  appointmentId String?

  amount       Decimal           @db.Decimal(10, 2)
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  provider     PaymentProvider
  providerRef  String?           // id du provider (Stripe session id, airtel ref)
  description  String?

  // relations, noms explicites pour lever ambiguïté
  doctor       User   @relation("DoctorTransactions", fields: [doctorId], references: [id])
  patient      User   @relation("PatientTransactions", fields: [patientId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
}

enum TransactionType {
  PAYMENT
  PAYOUT
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Wallet {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  doctor    User             @relation(fields: [doctorId], references: [id])
  movements WalletMovement[]
}

model WalletMovement {
  id        String       @id @default(cuid())
  walletId  String
  amount    Decimal      @db.Decimal(10, 2)
  type      MovementType
  createdAt DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}

enum MovementType {
  CREDIT
  DEBIT
  COMMISSION
  WITHDRAWAL
}

enum PaymentProvider {
  AIRTEL_MONEY
  STRIPE
}

model Facility {
  id          String    @id @default(cuid())
  name        String
  type        FacilityType
  description String?   @db.Text
  address     String?
  city        String?
  geoLat      Float?
  geoLng      Float?
  phone       String?
  email       String?
  website     String?
  services    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // many-to-many implicite : côté Facility on doit garder juste Facility[]
  doctors     DoctorProfile[]  @relation("DoctorFacilities")
}

enum FacilityType {
  CLINIC
  CHU
  POLYCLINIC
  CENTER
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "google", "facebook"
  providerAccountId String   // ID from the provider
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}