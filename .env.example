# Environment
NODE_ENV=development  # development | production

# API Configuration
PORT=3000
JWT_SECRET=your_jwt_secret_change_me_in_production_minimum_32_characters

# Database
# Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthdb?schema=public

# OR Supabase PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public

# Supabase (optional)
SUPABASE_KEY=your_supabase_key
SUPABASE_URL=https://your-project.supabase.co

# Payment - Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Payment - Airtel Money
AIRTEL_MONEY_API_KEY=xxx
AIRTEL_MONEY_CLIENT_ID=xxx
AIRTEL_MONEY_CLIENT_SECRET=xxx
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa/...

# Email Verification (SMTP Configuration)
# For Gmail: Use App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:3000

# Data Encryption - CRITICAL SECURITY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit this key to Git!
# Store securely in AWS Secrets Manager / Azure Key Vault in production
ENCRYPTION_KEY=generate_a_secure_random_key_32_bytes_base64

# OAuth - Google
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# OAuth - Facebook
# Get credentials from: https://developers.facebook.com/
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Prisma
PRISMA_CONNECT_ON_BOOT=true
PRISMA_MIGRATIONS=0
